# Backend security keys are generated automatically on first startup.
APP_ENV=production
PASSWORD_MIN_LENGTH=12

# Use the connection string for your existing MySQL database.
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@localhost/yullita_creaciones
HOST=127.0.0.1
PORT=8000

# Gmail requires an app password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:8000/api
